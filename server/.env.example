# CodeMind AI Server Environment Configuration
# Safe placeholder configuration (do not put real secrets in this file)

# Server Port and Environment
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# GitHub OAuth Configuration (Optional, for repository import)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:4000/api/github/callback

# Local Ollama AI Model Configuration
# Compatible tool-calling models: qwen2.5-coder:7b, llama3.1:8b, mistral:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Cloud Fallback (Optional - for when local Ollama is offline)
GROQ_API_KEY=your_groq_api_key_here

# Secure Execution Sandbox (Optional - for run_trace tool)
# Set to remote sandbox microservice or enable docker container
# SANDBOX_URL=http://localhost:8080
# DOCKER_SANDBOX_ENABLED=false

# Logging Level
LOG_LEVEL=info
